# Supabase signs Auth Hook requests with this Standard Webhooks secret.
# Expected format: v1,whsec_<base64-secret>
SEND_SMS_HOOK_SECRET=

# Meta WhatsApp Cloud API development credentials and configuration.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_API_VERSION=
META_WHATSAPP_TEMPLATE_NAME=telmizo_login_code
META_WHATSAPP_TEMPLATE_LANGUAGE=ar

# Development stays fail-closed. Use comma-separated Egyptian E.164 numbers.
# Never commit real numbers. Production intentionally does not support `*` yet.
META_WHATSAPP_ALLOWED_RECIPIENTS=
